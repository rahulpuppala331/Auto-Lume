# AutoLume Environment Variables
FLASK_PORT=5000
FLASK_ENV=development

# MongoDB Connection String (No hardcoded credentials)
# Example: mongodb://localhost:27017/autolume or MongoDB Atlas connection string
MONGODB_URI=mongodb://localhost:27017/autolume

# Path to trained YOLO license plate detection weights (.pt)
YOLO_MODEL_PATH=../models/license_plate_model.pt

# PyTesseract Binary Path (Optional if installed in standard PATH)
# Linux: /usr/bin/tesseract | Windows: C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_CMD=

# Demo mode toggle (true = return mock/sample results without real hardware)
DEMO_MODE=false
